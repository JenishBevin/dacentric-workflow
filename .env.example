# ---------------------------------------------------------------------------
# DaCentric Workflow Module — environment configuration
# Copy this file to .env (root) and .env inside apps/api, and adjust values.
# NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://dacentric:dacentric@localhost:5432/dacentric_workflow?schema=public"
POSTGRES_USER=dacentric
POSTGRES_PASSWORD=dacentric
POSTGRES_DB=dacentric_workflow

# --- API ---------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:5173

# JWT / sessions (generate real random secrets in production, e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-access-secret-change-me
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MIN=30

# Invitation / password reset token lifetimes
INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_HOURS=2

# Account lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Email (pluggable adapter: "console" | "smtp") ---------------------------
 EMAIL_PROVIDER=smtp
   SMTP_HOST=smtp.gmail.com
   SMTP_PORT=587
   SMTP_USER=your-email@gmail.com
   SMTP_PASSWORD=your-app-password
   SMTP_FROM=your-email@gmail.com

# --- File storage (pluggable adapter: "local" | "s3") ------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE_MB=25
STORAGE_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.gif,.doc,.docx,.xls,.xlsx,.csv,.txt,.zip,.ppt,.pptx

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Recurrence scheduler ------------------------------------------------------
RECURRENCE_CRON="*/15 * * * *"

# --- Frontend (apps/web/.env) -------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api
